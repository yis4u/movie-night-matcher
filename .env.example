# These Firebase web identifiers are PUBLIC client configuration, not server secrets.
# Copy to .env.local. Add equivalent public repository Variables for GitHub Pages.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
# Set true only after deploying the TMDB callable functions and server secret.
VITE_TMDB_ENABLED=false
# Development only; ignored in production builds.
VITE_USE_FIREBASE_EMULATORS=false
# NEVER put TMDB_READ_TOKEN, service-account JSON, or Admin SDK keys in VITE_*.
